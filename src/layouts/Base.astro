---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/figtree';
import '../styles/site.css';
import { site } from '../site.config.js';

const { title, description = site.tagline, image = '/bilder/schlaf-experten-logo.jpg', path = '/', noindex = false, type = 'website', jsonld = null } = Astro.props;
const canonical = site.url + path;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    {image && <meta property="og:image" content={site.url + image} />}
    <meta name="twitter:card" content="summary_large_image" />
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  </head>
  <body>
    <a class="se-skip" href="#inhalt">Zum Inhalt springen</a>
    <header class="se-header">
      <div class="se-wrap se-header-inner">
        <a class="se-logo-link" href="/" aria-label="Schlaf-Experten Startseite">
          <img class="se-logo-img" src="/bilder/schlaf-experten-icon.png" alt="Schlaf-Experten" width="200" height="56" />
          <span>Schlaf-Experten</span>
        </a>
        <div class="se-search-wrapper" id="se-site-search">
          <div class="se-search-box">
            <svg class="se-search-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="8.5" cy="8.5" r="5.5"></circle>
              <line x1="12.5" y1="12.5" x2="17.5" y2="17.5"></line>
            </svg>
            <input
              type="search"
              class="se-search-input"
              id="se-search-input"
              placeholder="Themen, Tests, Rechner suchen..."
              autocomplete="off"
              aria-label="Website durchsuchen"
            />
            <button type="button" class="se-search-clear" id="se-search-clear" aria-label="Suche zurücksetzen" style="display:none;">&times;</button>
          </div>
          <div class="se-search-dropdown" id="se-search-dropdown" style="display:none;">
            <div class="se-search-results" id="se-search-results"></div>
            <div class="se-search-footer" id="se-search-footer">
              <span>Tipp: Suche nach Matratzen, Betten oder Rechnern</span>
              <span>ESC zum Schließen</span>
            </div>
          </div>
        </div>
        <input type="checkbox" id="se-nav-toggle" class="se-nav-toggle" />
        <label for="se-nav-toggle" class="se-nav-button"><span>Menü</span></label>
        <nav class="se-nav" aria-label="Hauptmenü">
          <a href="/#themen">Kategorien</a>
          <a href="/#beitraege">Tests &amp; Erfahrungen</a>
          <a href="/rechner/">Rechner</a>
          <a class="se-nav-service" href="/schlaf-services/">Services</a>
        </nav>
      </div>
    </header>
    <main id="inhalt">
      <slot />
    </main>
    <footer class="se-footer">
      <div class="se-wrap">
        <div class="se-footer-cols">
          <div class="se-footer-brand">
            <span class="se-footer-name">Schlaf-Experten</span>
            <p>{site.tagline}</p>
          </div>
          <div>
            <span class="se-footer-head">Themen</span>
            <div class="se-footer-links">
              {site.categories.map((c) => <a href={`/#themen`}>{c.name}</a>)}
            </div>
          </div>
          <div>
            <span class="se-footer-head">Vor Ort</span>
            <div class="se-footer-links">
              <a href="/schlaf-services/">Schlaf-Services Übersicht</a>
              <a href="/rechner/">Schlaf-Rechner</a>
              <a href="/schlaf-services/#schlafanalyse">Schlafanalyse &amp; Beratung</a>
              <a href="/schlaf-services/#schlafcoaching">Schlaf-Coaching</a>
              <a href="/schlaf-services/#workshops">Workshops</a>
              <a href="/schlaf-services/#kaufberatung">Matratzen-Kaufberatung</a>
            </div>
          </div>
          <div>
            <span class="se-footer-head">Rechtliches</span>
            <div class="se-footer-links">
              <a href="/impressum/">Impressum</a>
              <a href="/datenschutzerklaerung/">Datenschutzerklärung</a>
            </div>
          </div>
        </div>
        <div class="se-footer-bottom">
          <p>© {year} Schlaf-Experten. Alle Rechte vorbehalten.</p>
        </div>
      </div>
    </footer>
    <script is:inline>
      // YouTube erst nach Klick laden (vorher keine Verbindung zu YouTube)
      document.addEventListener('click', function (e) {
        var b = e.target.closest('.se-video-play');
        if (!b) return;
        var box = b.closest('.se-video');
        var f = document.createElement('iframe');
        f.src = 'https://www.youtube-nocookie.com/embed/' + box.dataset.video + '?autoplay=1&rel=0';
        f.title = box.dataset.title || 'Video';
        f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        f.allowFullscreen = true;
        box.innerHTML = '';
        box.appendChild(f);
      });

      // Header Live-Suche
      (function() {
        var input = document.getElementById('se-search-input');
        var wrapper = document.getElementById('se-site-search');
        var dropdown = document.getElementById('se-search-dropdown');
        var resultsBox = document.getElementById('se-search-results');
        var clearBtn = document.getElementById('se-search-clear');
        if (!input || !dropdown || !resultsBox) return;

        var searchIndex = null;
        var isLoading = false;
        var selectedIndex = -1;

        function loadIndex(callback) {
          if (searchIndex) {
            if (callback) callback(searchIndex);
            return;
          }
          if (isLoading) return;
          isLoading = true;
          fetch('/suchindex.json')
            .then(function(res) { return res.json(); })
            .then(function(data) {
              searchIndex = data;
              isLoading = false;
              if (callback) callback(searchIndex);
            })
            .catch(function(err) {
              console.error('Fehler beim Laden des Suchindex:', err);
              isLoading = false;
            });
        }

        wrapper.addEventListener('mouseenter', function() { loadIndex(); });
        wrapper.addEventListener('touchstart', function() { loadIndex(); }, { passive: true });

        function escapeHtml(str) {
          return (str || '').replace(/[&<>"']/g, function(m) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m];
          });
        }

        function highlightMatch(text, query) {
          if (!query) return escapeHtml(text);
          var escapedQuery = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
          var regex = new RegExp('(' + escapedQuery + ')', 'gi');
          return escapeHtml(text).replace(regex, '<mark>$1</mark>');
        }

        function renderResults(query) {
          if (!searchIndex) {
            resultsBox.innerHTML = '<div class="se-search-empty">Lade Suchindex...</div>';
            dropdown.style.display = 'flex';
            return;
          }

          var q = query.trim().toLowerCase();
          if (!q) {
            dropdown.style.display = 'none';
            if (clearBtn) clearBtn.style.display = 'none';
            return;
          }

          if (clearBtn) clearBtn.style.display = 'inline-flex';

          var terms = q.split(/\s+/).filter(Boolean);
          var matches = searchIndex.filter(function(item) {
            var haystack = ((item.title || '') + ' ' + (item.fullTitle || '') + ' ' + (item.category || '') + ' ' + (item.excerpt || '')).toLowerCase();
            return terms.every(function(t) { return haystack.indexOf(t) !== -1; });
          }).slice(0, 8);

          selectedIndex = -1;

          if (matches.length === 0) {
            resultsBox.innerHTML = '<div class="se-search-empty">Keine Ergebnisse für <strong>„' + escapeHtml(q) + '“</strong> gefunden.</div>';
          } else {
            var html = matches.map(function(item, idx) {
              var badgeClass = 'se-badge-test';
              if (item.type === 'Rechner') badgeClass = 'se-badge-rechner';
              else if (item.type === 'Service') badgeClass = 'se-badge-service';

              var scoreHtml = item.score ? '<span class="se-pill" style="font-size:11px;padding:2px 6px;">' + item.score + '/100</span>' : '';

              return '<a class="se-search-item" href="' + item.url + '" data-index="' + idx + '">' +
                '<div class="se-search-item-top">' +
                  '<span class="se-search-item-badge ' + badgeClass + '">' + item.type + '</span>' +
                  '<span class="se-search-item-cat">' + escapeHtml(item.category) + '</span>' +
                  scoreHtml +
                '</div>' +
                '<div class="se-search-item-title">' + highlightMatch(item.title, terms[0]) + '</div>' +
                (item.excerpt ? '<div class="se-search-item-desc">' + escapeHtml(item.excerpt) + '</div>' : '') +
              '</a>';
            }).join('');
            resultsBox.innerHTML = html;
          }

          dropdown.style.display = 'flex';
        }

        input.addEventListener('focus', function() {
          loadIndex(function() {
            if (input.value.trim()) {
              renderResults(input.value);
            }
          });
        });

        input.addEventListener('input', function() {
          loadIndex(function() {
            renderResults(input.value);
          });
        });

        if (clearBtn) {
          clearBtn.addEventListener('click', function() {
            input.value = '';
            dropdown.style.display = 'none';
            clearBtn.style.display = 'none';
            input.focus();
          });
        }

        input.addEventListener('keydown', function(e) {
          var items = resultsBox.querySelectorAll('.se-search-item');
          if (!items.length || dropdown.style.display === 'none') {
            if (e.key === 'Escape') dropdown.style.display = 'none';
            return;
          }

          if (e.key === 'ArrowDown') {
            e.preventDefault();
            selectedIndex = (selectedIndex + 1) % items.length;
            updateSelection(items);
          } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            selectedIndex = (selectedIndex - 1 + items.length) % items.length;
            updateSelection(items);
          } else if (e.key === 'Enter') {
            if (selectedIndex >= 0 && items[selectedIndex]) {
              e.preventDefault();
              items[selectedIndex].click();
            }
          } else if (e.key === 'Escape') {
            dropdown.style.display = 'none';
          }
        });

        function updateSelection(items) {
          items.forEach(function(el, idx) {
            if (idx === selectedIndex) {
              el.classList.add('is-selected');
              el.scrollIntoView({ block: 'nearest' });
            } else {
              el.classList.remove('is-selected');
            }
          });
        }

        document.addEventListener('click', function(e) {
          if (wrapper && !wrapper.contains(e.target)) {
            dropdown.style.display = 'none';
          }
        });
      })();
    </script>
  </body>
</html>
