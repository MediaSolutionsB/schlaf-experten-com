---
import fs from 'node:fs';
import Base from '../layouts/Base.astro';
const html = fs.readFileSync('content/legal/datenschutz.html', 'utf-8');
---
<Base title="Datenschutzerklärung - Schlaf-Experten" description="Datenschutzerklärung von schlaf-experten.com gemäß DSGVO" path="/datenschutzerklaerung/" noindex={true}>
  <div class="se-wrap">
    <article class="se-article-container">
      <header class="se-article-head">
        <h1>Datenschutzerklärung</h1>
      </header>
      <div class="se-article-content" set:html={html} />
    </article>
  </div>
</Base>
